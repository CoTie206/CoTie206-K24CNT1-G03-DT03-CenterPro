@model NhapPhongHocModel
@{ ViewData["Title"] = "Thêm phòng học"; }
<h1 class="h2 mb-3">Thêm phòng học</h1>
<div class="card cp-form"><div class="card-body"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="TenPhongHoc" class="form-label"></label><input asp-for="TenPhongHoc" class="form-control" autofocus /><span asp-validation-for="TenPhongHoc" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Lưu</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
