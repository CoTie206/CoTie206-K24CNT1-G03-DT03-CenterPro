@model NhapLopHocModel
@{ ViewData["Title"] = "Sửa lớp học"; }
<h1 class="h2 mb-3">Sửa lớp học</h1>
<div class="card cp-form"><div class="card-body"><form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="TenLopHoc" class="form-label"></label><input asp-for="TenLopHoc" class="form-control" /><span asp-validation-for="TenLopHoc" class="text-danger"></span></div><div class="mb-3"><label asp-for="MaGiangVien" class="form-label"></label><select asp-for="MaGiangVien" asp-items="ViewBag.GiangVien" class="form-select"><option value="0">-- Chọn giảng viên --</option></select><span asp-validation-for="MaGiangVien" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Lưu thay đổi</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
