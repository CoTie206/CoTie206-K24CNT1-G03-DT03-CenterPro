@model LopHoc
@{ ViewData["Title"] = "Xóa lớp học"; }
<div class="card border-danger cp-form"><div class="card-body"><h1 class="h3">Xóa lớp học?</h1><p>Bạn có chắc muốn xóa <strong>@Model.TenLopHoc</strong> không?</p><p>Giảng viên: @Model.GiangVien.HoTen</p><p class="text-muted">Lớp đang được đề xuất hoặc lịch học tham chiếu sẽ không thể xóa.</p><form asp-action="Delete" asp-route-id="@Model.MaLopHoc" method="post"><button class="btn btn-danger" type="submit">Xác nhận xóa</button> <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></form></div></div>
