<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CenterPro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark cp-nav">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">CenterPro</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                    @if (User.IsInRole("TrainingStaff") || User.IsInRole("Administrator"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="GiangVien" asp-action="Index">Giảng viên</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhongHoc" asp-action="Index">Phòng học</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="LopHoc" asp-action="Index">Lớp học</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3 text-white">
                    <span class="small">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light" type="submit">Đăng xuất</button></form>
                </div>
            }
            else
            {
                <ul class="navbar-nav me-auto"></ul>
                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </div>
    </div>
</nav>
<main class="container py-4">
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="container border-top py-3 small text-muted">CenterPro · DT03 · K24CNT1-G03</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
