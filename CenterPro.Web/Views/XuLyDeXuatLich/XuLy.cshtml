@model CenterPro.Data.Domain.DeXuatLichDay
@{
    ViewData["Title"] = "Xử lý đề xuất";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Xử lý đề xuất lịch dạy #@Model.MaDeXuatLich</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-4">
                    <dt class="col-sm-4">Lớp học</dt>
                    <dd class="col-sm-8">@Model.LopHoc.TenLopHoc</dd>

                    <dt class="col-sm-4">Giảng viên</dt>
                    <dd class="col-sm-8">@Model.GiangVien.HoTen</dd>

                    <dt class="col-sm-4">Thời gian đề xuất</dt>
                    <dd class="col-sm-8">
                        @Model.ThoiGianBatDauDeXuat.ToString("dd/MM/yyyy HH:mm")
                        → @Model.ThoiGianKetThucDeXuat.ToString("HH:mm")
                    </dd>

                    <dt class="col-sm-4">Ngày gửi</dt>
                    <dd class="col-sm-8">@Model.ThoiGianGui.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>

                <hr />

                <!-- Form xác nhận -->
                <form asp-action="XacNhan" method="post" class="mb-3">
                    <input type="hidden" name="id" value="@Model.MaDeXuatLich" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn phòng học</label>
                        <select name="maPhongHoc" class="form-select" required>
                            <option value="">-- Chọn phòng trống --</option>
                            @foreach (var item in (SelectList)ViewBag.PhongHoc)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <div class="form-text">Chỉ hiển thị các phòng còn trống trong khung giờ này.</div>
                    </div>
                    <button type="submit" class="btn btn-success">
                        Xác nhận & Tạo lịch
                    </button>
                </form>

                <!-- Form từ chối -->
                <form asp-action="TuChoi" method="post" onsubmit="return confirm('Bạn chắc chắn muốn từ chối đề xuất này?');">
                    <input type="hidden" name="id" value="@Model.MaDeXuatLich" />
                    <button type="submit" class="btn btn-outline-danger">Từ chối đề xuất</button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>